            Button("Jag godkänner", action: onAccept)
                .buttonStyle(.borderedProminent)
                .frame(maxWidth: .infinity)
        }
        .padding(24)
    }
}

struct SearchScreen: View {
    enum SearchState {
        case idle, searching, empty
        case results([SearchResult], textOnly: Bool)
        case failed(String)
    }

    @Environment(AppEnvironment.self) private var env
    @State private var query = ""
    @State private var state: SearchState = .idle
    @State private var searchTask: Task<Void, Never>?

    var body: some View {
        NavigationStack {
            VStack(spacing: 0) {
                IndexStatusBar()
                content.frame(maxHeight: .infinity)
            }
            .navigationTitle("PicFinder")
            .searchable(text: $query, prompt: "Beskriv bilden du letar efter")
            .onSubmit(of: .search, runSearch)
            .toolbar {
                if env.library.status == .limited {
                    Button("Välj bilder") { env.library.presentLimitedPicker() }
                }
            }
            .task {
                env.library.startObservingIfAllowed()
                env.indexer.start()
            }
        }
    }

    @ViewBuilder
    private var content: some View {
        switch state {
        case .idle:
            ContentUnavailableView("Sök med egna ord", systemImage: "sparkle.magnifyingglass",
                                   description: Text("T.ex. ”hunden på stranden i solnedgången”"))
        case .searching:
            ProgressView("Söker …")
        case .empty:
            ContentUnavailableView.search(text: query)
        case .failed(let message):
            ContentUnavailableView("Sökningen misslyckades", systemImage: "exclamationmark.triangle",
                                   description: Text(message))
        case .results(let results, let textOnly):
            ScrollView {
                if textOnly {
                    Text("Ingen anslutning – visar bara träffar på text och ord.")
                        .font(.footnote)
                        .foregroundStyle(.secondary)
                        .padding(.top, 8)
                }
                LazyVGrid(columns: [GridItem(.adaptive(minimum: 110), spacing: 2)], spacing: 2) {
                    ForEach(results) { AssetThumbnail(localIdentifier: $0.id) }
                }
            }
        }
    }

    private func runSearch() {
        searchTask?.cancel()
        let q = query
        state = .searching
        searchTask = Task {
            do {
                let outcome = try await env.search.search(q)
                guard !Task.isCancelled else { return }
                state = outcome.results.isEmpty ? .empty : .results(outcome.results, textOnly: outcome.textOnly)
            } catch is CancellationError {
            } catch {
                state = .failed(error.localizedDescription)
            }
        }
    }
}

struct AssetThumbnail: View {
    let localIdentifier: String
    @State private var image: UIImage?

    var body: some View {
        Color(.secondarySystemBackground)
            .aspectRatio(1, contentMode: .fit)
            .overlay {
                if let image { Image(uiImage: image).resizable().scaledToFill() }
            }
            .clipped()
            .task(id: localIdentifier) {
                guard let asset = PHAsset.fetchAssets(withLocalIdentifiers: [localIdentifier], options: nil).firstObject else { return }
                image = try? await PhotoLibraryService.loadImage(for: asset, maxPixel: 300)
            }
    }
}

struct IndexStatusBar: View {
    @Environment(AppEnvironment.self) private var env

    var body: some View {
        switch env.indexer.phase {
        case .idle, .finished:
            EmptyView()
        case .scanning:
            bar {
                ProgressView()
                Text("Läser bildbiblioteket …")
            }
        case .indexing(let done, let total):
            bar {
                ProgressView(value: Double(done), total: Double(max(total, 1)))
                Text("\(done)/\(total)").monospacedDigit()
                Button("Pausa") { env.indexer.cancel() }
            }
        case .paused(let reason):
            bar {
                Image(systemName: "pause.circle")
                Text(reason).lineLimit(2)
                Spacer()
                Button("Fortsätt") { env.indexer.start() }
            }
        }
    }

    private func bar<C: View>(@ViewBuilder _ content: () -> C) -> some View {
        HStack(spacing: 10, content: content)
            .font(.footnote)
            .padding(.horizontal)
            .padding(.vertical, 8)
            .frame(maxWidth: .infinity, alignment: .leading)
            .background(.bar)
    }
}
