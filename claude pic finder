enum AppConfig {
    static var apiBaseURL: URL {
        guard let s = Bundle.main.object(forInfoDictionaryKey: "PicFinderAPIBaseURL") as? String,
              !s.isEmpty, let url = URL(string: s) else {
            fatalError("PicFinderAPIBaseURL saknas – kontrollera Secrets.xcconfig och Info.")
